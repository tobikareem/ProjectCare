@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout
@using CarePath.Client.Api
@using CarePath.Client.UI.Components
@using CarePath.Client.UI.Theming
@using CarePath.Contracts.Auth
@using CarePath.Contracts.Common
@using CarePath.Contracts.Enumerations
@using CarePath.Contracts.Organization
@inject AuthClient Auth
@inject OrganizationBrandingClient Branding
@inject TokenAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Sign in — @BrandName</PageTitle>

<div class="card auth-card" style="@BrandStyle">
    <div class="auth-brand" aria-hidden="true">
        <span class="auth-brand-mark">@BrandingTokens.Monogram(BrandName)</span>
        <span><strong>@BrandName</strong><span class="auth-brand-sub">Operations</span></span>
    </div>
    <h1 class="auth-heading">Sign in</h1>
    <p class="subtle">Use your @BrandName staff account.</p>

    <form @onsubmit="SignInAsync" @onsubmit:preventDefault="true">
        <label class="auth-label" for="login-email">Email</label>
        <input id="login-email" class="auth-input" type="email" autocomplete="username"
               required @bind="_email" @bind:event="oninput" />

        <label class="auth-label" for="login-password">Password</label>
        <input id="login-password" class="auth-input" type="password" autocomplete="current-password"
               required @bind="_password" @bind:event="oninput" />

        @if (_error is not null)
        {
            <div class="auth-alert">
                <ApiErrorAlert Response="_error" />
            </div>
        }

        <button class="button button-primary auth-submit" type="submit"
                disabled="@(_submitting || !CanSubmit)">
            @(_submitting ? "Signing in…" : "Sign in")
        </button>
    </form>
</div>

@code {
    // CREDENTIAL SAFETY (D-S6-2/D-S6-3): the form fields are never logged or echoed; the token
    // session lives only in the in-memory provider — never cookies or browser storage.
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _submitting;
    private ApiResponse? _error;

    // ORGANIZATION BRANDING (CP-04 FR-012): resolved from the request host by the server. An
    // unknown host (404) or any failure falls back silently to the neutral CarePath brand — the
    // login page never reveals whether a host is a known organization beyond what it renders.
    private OrganizationBrandingDto? _branding;

    /// <summary>Requested post-login path, set by <see cref="RedirectToLogin"/>. Guid-only routes, no PHI.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_email) && !string.IsNullOrWhiteSpace(_password);

    private string BrandName => string.IsNullOrWhiteSpace(_branding?.DisplayName) ? "CarePath" : _branding.DisplayName;

    private string BrandStyle => _branding is null
        ? BrandingTokens.BrandStyle(BrandingColorToken.Teal900, BrandingColorToken.Orange)
        : BrandingTokens.BrandStyle(_branding.PrimaryColorToken, _branding.AccentColorToken);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState.HasActiveSession)
        {
            Navigation.NavigateTo(SafeReturnUrl(), replace: true);
            return;
        }

        try
        {
            // The neutral brand is already rendered; branding is applied when (and only if) it
            // arrives. Any failure — transport, timeout, a static host answering /api with HTML —
            // leaves the neutral brand in place so the form is never blocked.
            var response = await Branding.GetAsync();
            if (response is { Success: true, Data: not null } && !string.IsNullOrWhiteSpace(response.Data.DisplayName))
            {
                _branding = response.Data;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException or NotSupportedException)
        {
            // Nothing is logged here: the failure carries no actionable client-side detail.
        }
    }

    private async Task SignInAsync()
    {
        if (_submitting || !CanSubmit)
        {
            return;
        }

        _submitting = true;
        _error = null;

        try
        {
            var response = await Auth.LoginAsync(new LoginRequest { Email = _email.Trim(), Password = _password });
            if (response is { Success: true, Data: not null })
            {
                AuthState.MarkSignedIn(response.Data);
                _password = string.Empty;
                Navigation.NavigateTo(SafeReturnUrl(), replace: true);
                return;
            }

            _error = response;
        }
        catch (HttpRequestException)
        {
            // PHI/credential-safe generic failure — never surface exception details.
            _error = ApiResponse.Fail(new ApiError("network.unreachable", "The server could not be reached."));
        }

        _submitting = false;
    }

    // Only same-origin relative paths — an absolute or protocol-relative returnUrl is discarded
    // so login can never open-redirect off the app.
    private string SafeReturnUrl() =>
        !string.IsNullOrEmpty(ReturnUrl)
        && !ReturnUrl.Contains("://", StringComparison.Ordinal)
        && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : string.Empty;
}
