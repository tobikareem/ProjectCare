{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:{ServerName},1433;Initial Catalog={DatabaseName};Persist Security Info=False;User ID={UserId};Password={Password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "ControlPlaneConnection": "Server=tcp:{ServerName},1433;Initial Catalog={ControlPlaneDatabaseName};Persist Security Info=False;User ID={UserId};Password={Password};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ControlPlane": {
    "PlatformHostNames": [],
    "PlatformBaseDomain": "carepathhealth.com",
    "TrustedProxies": {
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "BrandingCacheSeconds": 60,
    "HostDenialAuditWindowSeconds": 60
  }
}
